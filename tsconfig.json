{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "importHelpers": true,
    "experimentalDecorators": true,
    "strictFunctionTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "baseUrl": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@bit-labs.cn/owl-ui": [
        "src/index.ts"
      ],
      "@bit-labs.cn/owl-ui/core": [
        "core/index.ts"
      ],
      "@bit-labs.cn/owl-ui/core/*": [
        "core/*"
      ],
      "@bit-labs.cn/owl-ui/theme": [
        "theme/default/style/index.scss"
      ],
      "@bit-labs.cn/owl-ui/theme/login.css": [
        "theme/default/style/login.css"
      ],
      "@bit-labs.cn/owl-ui/theme/tailwind.css": [
        "theme/default/style/tailwind.css"
      ],
      "@bit-labs.cn/owl-ui/theme/default": [
        "theme/default/index.ts"
      ],
      "@bit-labs.cn/owl-ui/theme/default/*": [
        "theme/default/*"
      ],
      "@bit-labs.cn/owl-ui/theme/shared/*": [
        "theme/shared/*"
      ],
      "@bit-labs.cn/owl-ui/theme/*": [
        "theme/*"
      ],
      "@bit-labs.cn/owl-ui/shared/*": [
        "theme/shared/*"
      ],
      "@bit-labs.cn/owl-ui/components/*": [
        "theme/shared/components/*"
      ],
      "@bit-labs.cn/owl-ui/directives": [
        "theme/shared/directives/index.ts"
      ],
      "@bit-labs.cn/owl-ui/directives/*": [
        "theme/shared/directives/*"
      ],
      "@bit-labs.cn/owl-ui/plugins/*": [
        "theme/shared/plugins/*"
      ],
      "@bit-labs.cn/owl-ui/assets/*": [
        "theme/shared/assets/*"
      ],
      "@bit-labs.cn/owl-ui/layout": [
        "theme/default/layout/index.vue"
      ],
      "@bit-labs.cn/owl-ui/layout/*": [
        "theme/default/layout/*"
      ],
      "@bit-labs.cn/owl-ui/views/*": [
        "theme/default/views/*"
      ],
      "@bit-labs.cn/owl-ui/bootstrap": [
        "theme/default/bootstrap.ts"
      ],
      "@bit-labs.cn/owl-ui/build-preset": [
        "builder/build-preset/index.ts"
      ],
      "@bit-labs.cn/owl-ui/api/*": [
        "core/api/*"
      ],
      "@bit-labs.cn/owl-ui/config": [
        "core/config/index.ts"
      ],
      "@bit-labs.cn/owl-ui/config/*": [
        "core/config/*"
      ],
      "@bit-labs.cn/owl-ui/store": [
        "core/store/index.ts"
      ],
      "@bit-labs.cn/owl-ui/store/*": [
        "core/store/*"
      ],
      "@bit-labs.cn/owl-ui/router": [
        "core/router/index.ts"
      ],
      "@bit-labs.cn/owl-ui/router/*": [
        "core/router/*"
      ],
      "@bit-labs.cn/owl-ui/subsystem": [
        "core/subsystem/index.ts"
      ],
      "@bit-labs.cn/owl-ui/subsystem/*": [
        "core/subsystem/*"
      ],
      "@bit-labs.cn/owl-ui/utils/*": [
        "core/utils/*"
      ],
      "@bit-labs.cn/owl-ui/layout/types": [
        "core/layout/types.ts"
      ],
      "@bit-labs.cn/owl-ui/layout/constants": [
        "core/layout/constants.ts"
      ],
      "@bit-labs.cn/owl-ui/layout/utils/*": [
        "core/layout/utils/*"
      ],
      "@bit-labs.cn/owl-ui/*": [
        "src/*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "element-plus/global",
      "@pureadmin/table/volar",
      "@pureadmin/descriptions/volar"
    ]
  },
  "include": [
    "core/**/*.ts",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "theme/**/*.vue",
    "builder/build-preset/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "types/*.d.ts"
  ],
  "exclude": [
    "dist",
    "**/*.js",
    "node_modules"
  ]
}
